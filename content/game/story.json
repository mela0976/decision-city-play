{
  "premise": "今晚九點要比一個大稿，題目是未來十年品牌怎麼跟人靠近；你要在信義區跑九個現場，每過一關拿到提案的一頁。",
  "prologue": [
    {
      "who": "grandma",
      "text": "【早安】平安就是福，出門記得穿外套。",
      "via": "line"
    },
    {
      "who": "player",
      "text": "樓下早餐店的鐵板聲比鬧鐘準。機車又發不動，踩了第三次才著。"
    },
    {
      "who": "breakfast_auntie",
      "text": "老樣子？蛋餅加辣、奶茶去冰，好了叫你。"
    },
    {
      "who": "boss_lin",
      "text": "今晚九點比稿。題目：未來十年，品牌怎麼跟人靠近。",
      "via": "line"
    },
    {
      "who": "boss_lin",
      "text": "簡報目前零頁。",
      "via": "line"
    },
    {
      "who": "data_kai",
      "text": "看到了。你今天跑九個現場對吧？每過一關傳一頁給我，我來排。",
      "via": "line"
    },
    {
      "who": "rival_vicky",
      "text": "聽說你們也接到這個稿？晚上見，這次不會讓你。",
      "via": "line"
    },
    {
      "who": "breakfast_auntie",
      "text": "比稿喔？蛋餅多加一顆蛋，算阿姨的，吃飽才有力氣。"
    }
  ],
  "morning": {
    "clock": "08:10",
    "title": "晨會",
    "lines": [
      { "who": "boss_lin", "text": "人都到了。今晚九點比稿，時間不改。" },
      { "who": "boss_lin", "text": "題目你們看過了。客戶要的，是十年的決策智慧。" },
      { "who": "player", "text": "簡報目前零頁，我知道。九個現場，從哪裡開始？" },
      { "who": "ae_mei", "text": "先去捷運市府站，吳經理的看板案。他說人潮九點就散，動作要快。" },
      { "who": "ae_mei", "text": "十點回這裡，林總要跟你對數字。後面幾站我邊走邊傳給你。" },
      { "who": "ae_mei", "text": "薇琪也接到同一個稿，路上遇到她，別被套話。" },
      { "who": "data_kai", "text": "每跑完一站，把看到的資料傳給我，我來排頁面。" },
      { "who": "data_kai", "text": "截圖、照片、錄音都行，但數字要有來源，不然我不收。" },
      { "who": "player", "text": "收到。一站一頁，九點前把九頁湊齊。" },
      { "who": "boss_lin", "text": "去吧。" },
      { "who": "boss_lin", "text": "九點前回來。" }
    ],
    "back": [
      { "who": "ae_mei", "text": "還在外面跑？林總說九點前回來。" },
      { "who": "ae_mei", "text": "咖啡我幫你留著，先去忙你的。" },
      { "who": "data_kai", "text": "資料傳來我就排，沒傳我就當你還在騎車。" },
      { "who": "data_kai", "text": "別在門口發呆，數字不會自己跑進簡報。" },
      { "who": "boss_lin", "text": "九點。別遲到。" },
      { "who": "ae_mei", "text": "薇琪那邊也在跑，我們不能比她慢。" },
      { "who": "data_kai", "text": "會議室沒人也沒簡報，去跑現場比較快。" }
    ]
  },
  "cast": [
    {
      "id": "partner",
      "npcId": "data_kai",
      "role": "搭檔",
      "blurb": "同期進公司，嘴很壞，但每次出事都是他先幫你擋。"
    },
    {
      "id": "boss",
      "npcId": "boss_lin",
      "role": "主管",
      "blurb": "當面話不多，LINE 幾乎只回「？」和「OK」，要交代事情才打字，真心話一年說一次。"
    },
    {
      "id": "rival",
      "npcId": "rival_vicky",
      "role": "老對手",
      "blurb": "跳槽到對手代理商的前同事，今晚跟你比同一個稿。"
    },
